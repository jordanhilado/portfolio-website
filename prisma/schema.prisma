// Datasource and generator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  content    String // markdown content
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Optional metadata for future features
  coverImage String? // URL to image
}

model AboutContent {
  id           String   @id @default(cuid())
  content      String // JSON array of paragraphs
  contactLinks String? // JSON array of markdown-style links: ["[Link Title](url)", ...]
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  link        String
  order       Int      @default(0) // For custom ordering
  /// Year the project was built, shown in the corner of its card. Rows that
  /// predate this column were backfilled with the year they were created and
  /// are placeholders until corrected in the admin dashboard.
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RunningContent {
  id        String   @id @default(cuid())
  content   String // markdown content
  updatedAt DateTime @updatedAt
}

/// A finished race, shown as a card above the run grid.
///
/// Unlike StravaRun, which is synced from the API and therefore metric, these
/// rows are hand-entered by scripts/seed-races.ts and stored in the units the
/// card displays — nothing is round-tripped through a conversion on its way to
/// the page. `slug` is the upsert key that makes re-running the seed script
/// update a race in place rather than duplicate it.
model Race {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  date               DateTime
  timeSeconds        Int
  paceSecondsPerMile Int
  elevationFeet      Int
  ageGroupRank       Int
  ageGroupTotal      Int
  ageGroup           String
  /// Square photo. Null renders a neutral placeholder of the same size.
  imageUrl           String?
  /// Null renders the card as static content rather than a link.
  resultsUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
}

/// A Strava activity mirrored locally. `polyline` is the raw encoded
/// summary_polyline (source of truth); `pathD` is the derived SVG path,
/// normalized into a 100x100 viewBox, cached so rendering does no work.
/// stravaId is a String, not BigInt: tsconfig targets es5, which bans
/// BigInt literals, and BigInt also breaks NextResponse.json() and RSC
/// serialization.
model StravaRun {
  id             String   @id @default(cuid())
  stravaId       String   @unique
  name           String
  sportType      String
  startDateLocal DateTime
  distanceMeters Float
  movingTime     Int
  polyline       String // raw encoded summary_polyline
  pathD          String // derived SVG path, 100x100 viewBox
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([startDateLocal])
}

/// Singleton cache for the Strava OAuth token pair. Seeded from
/// STRAVA_REFRESH_TOKEN, then self-maintaining — Strava may rotate the
/// refresh token on any exchange, and an env-only design breaks silently
/// and permanently when it does.
model StravaToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}
