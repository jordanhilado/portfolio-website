# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/context
.env

# dependencies
/node_modules
/.pnp
.pnp.js

# pnpm-lock.yaml is the only lockfile: Vercel detects it and installs with pnpm.
# A stray `bun install` regenerates bun.lockb resolving a second, conflicting
# copy of @types/react, which breaks the build with a type error in a file
# nobody touched. Ignored so it cannot come back.
bun.lockb

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# latex resume artifacts (keep only .tex and .pdf)
/src/assets/resume/*.aux
/src/assets/resume/*.fdb_latexmk
/src/assets/resume/*.fls
/src/assets/resume/*.log
/src/assets/resume/*.out
/src/assets/resume/*.synctex.gz

# mock resume
/src/assets/resume/mock/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
